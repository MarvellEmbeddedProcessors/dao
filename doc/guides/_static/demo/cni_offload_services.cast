[96.500084, "o", "\u001b[1;1H# CNI Offload\r\n\r\n# Set to valid docker registry\r\nREPOSITORY := quay.io/alkama\r\n\r\nfmt:\u001b[7;9Hgo fmt ./...\r\n\r\nvet:\u001b[10;9Hgo vet ./...\r\n\r\nclone-cilium:\u001b[13;9Hmkdir -p build;\u001b[14;9Hcd build && \\\u001b[15;9Hrm -fr cilium && \\\u001b[16;9Hgit clone https://github.com/cilium/cilium.git && \\\u001b[17;9Hcd cilium && git checkout c81fa2e447990c8834320b2c5401a4a759c76e55 && \\\u001b[18;9Hgit am ../../patches/cilium/*.patch;\r\n\r\nclone-offload-cni:\u001b[21;9Hmkdir -p build;\u001b[22;9Hcd build && \\\u001b[23;9Hrm -fr offload-cni && \\\u001b[24;9Hgit clone https://github.com/k8snetworkplumbingwg/sriov-cni offload-cni && \\\u001b[25;9Hcd offload-cni && git checkout fca6591297c0e52b6522573bd367ccb7d6551fd0 && \\\u001b[26;9Hgit am ../../patches/offload-cni/*.patch;\r\n\r\ncni-offload-agent:\u001b[29;9Hcd cmd/dpu/cniOffloadAgent; GOARCH=arm64 GOOS=linux go build ;\r\n\r\ncilium-offload-cni:\u001b[32;9Hcd build/cilium/plugins/cilium-offload-cni; GOARCH=arm64 GOOS=linux make ;\r\n\r\ndpu-components: cni-offload-agent cilium-offload-cni\u001b[35;9Hdocker buildx build --network=host --push --tag $(REPOSITOR"]
[96.500173, "o", "Y)/cni-offload-agent:latest -f Dockerfile.dpu --platform linux/arm64 .\r\n\r\noffload-cni: clone-offload-cni\u001b[38;9Hcd build/offload-cni/ ; cd cmd/offload-cni; go build;\r\n\r\nhost-components: offload-cni\u001b[41;9Hdocker build --network=host --push --tag $(REPOSITORY)/cni-offload-host:latest -f Dockerfile.host .\r\n\r\ncilium:\u001b[44;9Hcd build/cilium/ ; ARCH=multi DOCKER_REGISTRY=$(REPOSITORY) make docker-cilium-image ;\r\n\r\nbuild: fmt vet clone-cilium dpu-components host-components cilium\r\n\r\ndeploy-components:\u001b[49;9Hkubectl apply -f deployments/\u001b[1;1H\u001b[?25h"]

[262.912887, "o", "sudo tee /etc/systemd/system/cri-docker.service << EOF\r\n"]
[262.913203, "o", "> [Unit]\r\n"]
[262.913283, "o", "> "]
[262.914358, "o", "Description=CRI Interface for Docker Application Container Engine\r\n"]
[262.914593, "o", "> "]
[262.91632, "o", "Documentation=https://docs.mirantis.com\r\n"]
[262.916379, "o", "> "]
[262.916913, "o", "After=network-online.target firewalld.service docker.service\r\n"]
[262.917062, "o", "Requires=cri-docker.socket\r\n[Service]\r\nType=notify\r\nExecStart=/usr/local/bin/cri-dockerd --container-runtime-endpoint fd:// --network-plugin=cni --cni-bin-dir=/opt/cni/bin --cni-cache-dir=/var/lib/cni/cache --cni-conf-dir=/etc/cni/net.d\r\nExecReload=/bin/kill -s HUP $MAINPID\r\nTimeoutSec=0\r\nRestartSec=2\r\nRestart=always\r\nStartLimitBurst=3\r\nStartLimitInterval=60s\r\nLimitNOFILE=infinity\r\nLimitNPROC=infini"]
[262.917226, "o", "ty\r\nLimitCORE=infinity\r\nTasksMax=infinity\r\nDelegate=yes\r\nKillMode=process\r\n[Install]\r\n> "]
[262.917426, "o", "Wants=network-online.target\r\n"]
[262.917544, "o", "> "]
[262.917735, "o", "Requires=cri-docker.socket\r\n"]
[262.917842, "o", "> "]
[262.917933, "o", "[Service]\r\n"]
[262.918034, "o", "> "]
[262.918138, "o", "Type=notify\r\n"]
[262.918278, "o", "> "]
[262.919365, "o", "ExecStart=/usr/local/bin/cri-dockerd --container-runtime-endpoint fd:// --network-plugin=cni --cni-bin-dir=/opt/cni/bin --cni-cache-dir=/var/lib/cni/cache --cni-conf-dir=/etc/cni/net.d\r\n"]
[262.919608, "o", "> "]
[262.919729, "o", "ExecReload=/bin/kill -s HUP $MAINPID\r\n"]
[262.91978, "o", "> "]
[262.919842, "o", "TimeoutSec=0\r\n"]
[262.919903, "o", "> "]
[262.919962, "o", "RestartSec=2\r\n> "]
[262.919999, "o", "Restart=always\r\n"]
[262.920064, "o", "> "]
[262.920108, "o", "StartLimitBurst=3\r\n"]
[262.920154, "o", "> "]
[262.920204, "o", "StartLimitInterval=60s\r\n"]
[262.920243, "o", "> "]
[262.920283, "o", "LimitNOFILE=infinity\r\n"]
[262.920358, "o", "> "]
[262.920401, "o", "LimitNPROC=infinity\r\n> "]
[262.920462, "o", "LimitCORE=infinity\r\n"]
[262.920513, "o", "> "]
[262.920557, "o", "TasksMax=infinity\r\n"]
[262.920598, "o", "> "]
[262.920639, "o", "Delegate=yes\r\n"]
[262.920678, "o", "> "]
[262.920723, "o", "KillMode=process\r\n"]
[262.920765, "o", "> "]
[262.920811, "o", "[Install]\r\n"]
[262.920861, "o", "> "]
[262.920913, "o", "WantedBy=multi-user.target\r\n"]
[262.920949, "o", "> "]
[262.92097, "o", "EOF\r\n"]
[262.925469, "o", "[Unit]\r\nDescription=CRI Interface for Docker Application Container Engine\r\nDocumentation=https://docs.mirantis.com\r\nAfter=network-online.target firewalld.service docker.service\r\nWants=network-online.target\r\nRequires=cri-docker.socket\r\n[Service]\r\nType=notify\r\nExecStart=/usr/local/bin/cri-dockerd --container-runtime-endpoint fd:// --network-plugin=cni --cni-bin-dir=/opt/cni/bin --cni-cache-dir=/var/lib/cni/cache --cni-conf-dir=/etc/cni/net.d\r\nExecReload=/bin/kill -s HUP \r\nTimeoutSec=0\r\nRestartSec=2\r\nRestart=always\r\nStartLimitBurst=3\r\nStartLimitInterval=60s\r\nLimitNOFILE=infinity\r\nLimitNPROC=infinity\r\nLimitCORE=infinity\r\nTasksMax=infinity\r\nDelegate=yes\r\nKillMode=process\r\n[Install]\r\nWantedBy=multi-user.target\r\n"]
[262.92612, "o", "root@master:/home/alkama/k8s-cni-offload/cri-dockerd#  \r\n"]
[262.926194, "o", "root@master:/home/alkama/k8s-cni-offload/cri-dockerd# "]
[262.926314, "o", "sudo tee /etc/systemd/system/cri-docker.socket << EOF\r\n"]
[262.926375, "o", "> "]
[262.926429, "o", "[Unit]\r\n> "]
[262.926537, "o", "Description=CRI Docker Socket for the API\r\n"]
[262.92659, "o", "> "]
[262.926654, "o", "PartOf=cri-docker.service\r\n"]
[262.926705, "o", "> "]
[262.926756, "o", "[Socket]\r\n> "]
[262.92686, "o", "ListenStream=%t/cri-dockerd.sock\r\n"]
[262.926901, "o", "> "]
[262.926946, "o", "SocketMode=0660\r\n"]
[262.926993, "o", "> "]
[262.927042, "o", "SocketUser=root\r\n"]
[262.927088, "o", "> "]
[262.927153, "o", "SocketGroup=docker\r\n"]
[262.927193, "o", "> "]
[262.927241, "o", "[Install]\r\n> "]
[262.927314, "o", "WantedBy=sockets.target\r\n"]
[262.927353, "o", "> EOF"]
[263.733967, "o", "\r\n"]
[263.745057, "o", "[Unit]\r\nDescription=CRI Docker Socket for the API\r\nPartOf=cri-docker.service\r\n[Socket]\r\nListenStream=%t/cri-dockerd.sock\r\nSocketMode=0660\r\nSocketUser=root\r\nSocketGroup=docker\r\n[Install]\r\nWantedBy=sockets.target\r\n"]

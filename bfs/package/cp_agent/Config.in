config BR2_PACKAGE_CP_AGENT
	bool "Marvell CP AGENT"
	default y if BR2_aarch64
	select BR2_PACKAGE_LIBCONFIG
	select BR2_PACKAGE_PKGCONF
	help
		This is the octep_cp_agent package.

if BR2_PACKAGE_CP_AGENT

config BR2_PACKAGE_CP_AGENT_CONFIG
	string "CP Agent Configuration filename"
	default "arm64_cn9k_linux_gcc" \
		if BR2_aarch64 && BR2_MARVELL_SOC_IS_OCTEON9
	default "arm64_cn10k_linux_gcc" \
		if BR2_aarch64 && BR2_MARVELL_SOC_IS_OCTEON10

endif

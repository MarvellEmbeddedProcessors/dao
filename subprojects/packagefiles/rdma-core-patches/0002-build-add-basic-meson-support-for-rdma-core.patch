From adedf7d687dd4ae8c3c917b711df3ff00668e714 Mon Sep 17 00:00:00 2001
From: Harman Kalra <hkalra@marvell.com>
Date: Wed, 29 Oct 2025 15:07:46 +0530
Subject: [PATCH 2/2] build: add basic meson support for rdma core

Signed-off-by: Harman Kalra <hkalra@marvell.com>
Signed-off-by: Mohit Kumar Parjapat <mprajapat@marvell.com>
---
 meson.build   | 68 +++++++++++++++++++++++++++++++++++++++++++++++++++
 meson.options | 13 ++++++++++
 2 files changed, 81 insertions(+)
 create mode 100644 meson.build
 create mode 100644 meson.options

diff --git a/meson.build b/meson.build
new file mode 100644
index 00000000..8798ced6
--- /dev/null
+++ b/meson.build
@@ -0,0 +1,68 @@
+project(
+    'rdma-core',
+    'c',
+    meson_version: '>= 1.8.0',
+    default_options: ['warning_level=3'],
+)
+
+src_dir = meson.current_source_dir() + '/'
+build_script = src_dir + 'build.sh'
+
+kernel_dir = get_option('kernel_dir')
+build_host_dir = get_option('build_host_dir')
+rdma_core_kernel_header_src = src_dir + 'kernel-headers/rdma/'
+kernel_header_dst = kernel_dir + '/' + 'include/uapi/rdma/'
+message('Kernel headers: ' + kernel_dir)
+message('Build host directory: ' + build_host_dir)
+
+fs = import('fs')
+ib_user_header = rdma_core_kernel_header_src + 'ib_user_ioctl_verbs.h'
+if fs.exists(ib_user_header)
+    run_command(
+        'sudo',
+        'cp',
+        ib_user_header,
+        kernel_header_dst + 'ib_user_ioctl_verbs.h',
+        check: true
+    )
+else
+    message(ib_user_header + ' does not exist.')
+endif
+
+octep_abi_header = rdma_core_kernel_header_src + 'octep_rdma-abi.h'
+if fs.exists(octep_abi_header)
+    run_command(
+        'sudo',
+        'cp',
+	octep_abi_header,
+	kernel_header_dst,
+	check: true
+    )
+else
+    message(octep_abi_header + ' does not exist.')
+endif
+
+rdma_prefix = ''
+if build_host_dir != ''
+    rdma_prefix = build_host_dir + '/rdma_prefix'
+    message('Installing rdma-core to: ' + rdma_prefix)
+endif
+
+# Build rdma-core with prefix if provided
+if rdma_prefix != ''
+    run_command(
+        'bash',
+        build_script,
+        rdma_prefix,
+        check: true
+    )
+else
+    run_command(
+        'bash',
+        build_script,
+        check: true
+    )
+endif
+
+rdma_core_dep = declare_dependency()
+meson.override_dependency('rdma-core', rdma_core_dep)
diff --git a/meson.options b/meson.options
new file mode 100644
index 00000000..d42bcf7d
--- /dev/null
+++ b/meson.options
@@ -0,0 +1,13 @@
+option(
+  'kernel_dir',
+  type: 'string',
+  value: '',
+  description: 'Kernel Header path',
+)
+
+option(
+  'build_host_dir',
+  type: 'string',
+  value: '',
+  description: 'Build host directory path for rdma-core prefix installation',
+)
-- 

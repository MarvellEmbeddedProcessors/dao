#!/bin/bash
# SPDX-License-Identifier: Marvell-MIT
# Copyright (c) 2025 Marvell.

source $PROJECT_ROOT/ci/test/env/cn10k.env

DAO_SUITE=dao-rdma

# Tests run per scenario, so entry names are suffixed (rdma_*_mlx, rdma_*_octeon)
# and the base-name CMD_TIMEOUTS from cn10k.env no longer match. Set them here.
CMD_TIMEOUTS="rdma_mq_trf_mlx=60m rdma_mq_trf_octeon=60m rdma_perftest_mlx=60m rdma_perftest_octeon=60m"

# RDMA stack install path on EP_HOST (x86 host of EP_DEVICE).
EP_HOST_RDMA_PATH=${EP_HOST_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}

# RDMA stack install path on EP_REMOTE_HOST (x86 host of EP_REMOTE far Octeon).
EP_REMOTE_RDMA_PATH=${EP_REMOTE_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}

# Export the path to this conf so that other scripts can source this conf.
export TEST_ENV_CONF=$PROJECT_ROOT/ci/test/env/cn10k-rdma.env

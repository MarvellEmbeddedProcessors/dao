source $PROJECT_ROOT/ci/test/env/cn10k.env

DAO_SUITE=dao-rdma

EP_HOST_RDMA_PATH=${EP_HOST_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}
# EP_REMOTE is an x86 host in both RDMA topologies (Mellanox native-RoCE host
# or the DPU-to-DPU far octep_rdma host), identical to EP_HOST. It therefore
# uses the same freshly built host rdma stack (rdma-core with all providers
# incl. mlx5 + octep, plus perftest) rather than a static prebuilt bundle.
EP_REMOTE_RDMA_PATH=${EP_REMOTE_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}

# Export the path to this conf so that other scripts can source this conf.
export TEST_ENV_CONF=$PROJECT_ROOT/ci/test/env/cn10k-rdma.env

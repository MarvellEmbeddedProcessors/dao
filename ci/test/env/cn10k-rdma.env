# Copyright (c) 2025 Marvell.

source $PROJECT_ROOT/ci/test/env/cn10k.env

DAO_SUITE=dao-rdma

EP_HOST_RDMA_PATH=${EP_HOST_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}
# In Octeon-to-Octeon (DPU-to-DPU) mode the far side (EP_REMOTE) is an
# octep_rdma host, so it must use the octep-provider host rdma stack (the
# same x86 host build as EP_HOST_RDMA_PATH), not the upstream x86 rdma-core
# bundle which lacks the octep provider. In legacy remote mode keep the
# prebuilt bundle path.
if [[ -n "${EP_REMOTE_DEVICE:-}" ]]; then
	EP_REMOTE_RDMA_PATH=${EP_REMOTE_RDMA_PATH:-$BUILD_HOST_DIR/rdma_prefix}
else
	EP_REMOTE_RDMA_PATH=${EP_REMOTE_RDMA_PATH:-/tmp/rdma-core/build}
fi

# Export the path to this conf so that other scripts can source this conf.
export TEST_ENV_CONF=$PROJECT_ROOT/ci/test/env/cn10k-rdma.env

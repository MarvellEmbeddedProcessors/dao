source $PROJECT_ROOT/ci/test/env/cn10k.env

DAO_SUITE=dao-rdma-octterm

EP_HOST_RDMA_PATH=${EP_HOST_RDMA_PATH:-$EP_DIR/rdma_prefix}
EP_REMOTE_RDMA_PATH=${EP_REMOTE_RDMA_PATH:-$EP_DIR/rdma_prefix}

CMD_TIMEOUTS="rdma_octterm_mq_trf_mlx=60m rdma_octterm_mq_trf_octeon=60m"

ENV_NAME=cn10k-rdma-octterm
# Export the path to this conf so that other scripts can source this conf.
export TEST_ENV_CONF=$PROJECT_ROOT/ci/test/env/${ENV_NAME}.env

[binaries]
c = ['ccache', 'aarch64-none-linux-gnu-gcc']
cpp = ['ccache', 'aarch64-none-linux-gnu-g++']
ar = 'aarch64-none-linux-gnu-gcc-ar'
strip = 'aarch64-none-linux-gnu-strip'
pkgconfig = 'pkg-config'
#exe_wrapper = '/tmp/exe_wrapper.sh'

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'armv8.6-a'
endian = 'little'

[properties]
machine_args = '-mcpu=neoverse-n2'
platform = 'cn10k'
